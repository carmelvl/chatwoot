{
  "$schema": "https://developer.microsoft.com/json-schemas/teams/v1.17/MicrosoftTeams.schema.json",
  "manifestVersion": "1.17",
  "version": "1.0.0",
  "id": "REPLACE_WITH_TEAMS_APP_ID",
  "developer": {
    "name": "Kita Technologies, Inc.",
    "websiteUrl": "https://kita.ai",
    "privacyUrl": "https://kita.ai/privacy",
    "termsOfUseUrl": "https://kita.ai/terms"
  },
  "name": { "short": "Kita", "full": "Kita" },
  "description": {
    "short": "Talk to the Kita team in Microsoft Teams.",
    "full": "Message the Kita team directly from a chat or channel. Replies from our team arrive in the same thread."
  },
  "icons": { "color": "color.png", "outline": "outline.png" },
  "accentColor": "#FFFFFF",
  "bots": [
    {
      "botId": "REPLACE_WITH_TEAMS_APP_ID",
      "scopes": ["personal", "team", "groupChat"],
      "supportsFiles": true,
      "isNotificationOnly": false
    }
  ],
  "authorization": {
    "permissions": {
      "resourceSpecific": [
        { "name": "ChannelMessage.Read.Group", "type": "Application" },
        { "name": "ChatMessage.Read.Chat", "type": "Application" }
      ]
    }
  },
  "permissions": ["identity", "messageTeamMembers"],
  "validDomains": ["support.internal.kita.ai"]
}
