# kita-bridges configuration. Copy to kita-bridges/.env on the server. NEVER commit real values.
PORT=8080
# Public base URL of the bridge (Caddy serves it under /bridges on the support host).
BRIDGE_PUBLIC_URL=https://support.internal.kita.ai/bridges
BRIDGE_DB_PATH=/data/bridges.sqlite
# Agent attachments are served to customers from <BRIDGE_PUBLIC_URL>/media/<token>/<file>
# (never a Chatwoot URL). Links expire after this many days.
MEDIA_TTL_DAYS=90
LOG_LEVEL=info

# Chatwoot. Inside docker-compose the bridge reaches Rails directly.
CHATWOOT_BASE_URL=http://rails:3000
# Per-platform API-channel inbox: "Inbox identifier" and "Webhook secret" from
# Settings > Inboxes > <inbox> > Configuration. Leave a platform's vars blank to disable it.
CHATWOOT_SLACK_INBOX_IDENTIFIER=
CHATWOOT_SLACK_WEBHOOK_SECRET=
CHATWOOT_TEAMS_INBOX_IDENTIFIER=
CHATWOOT_TEAMS_WEBHOOK_SECRET=
CHATWOOT_VIBER_INBOX_IDENTIFIER=
CHATWOOT_VIBER_WEBHOOK_SECRET=

# Chatwoot Application API (Profile settings > Access token of a dedicated admin/agent user, e.g. "Kita Bridge").
# Enables: private "connect your account" notes, mirroring messages staff type directly in Slack/Teams,
# and agent avatars for the Slack fallback. Account id is the number in /app/accounts/<id>/...
CHATWOOT_API_ACCESS_TOKEN=
CHATWOOT_ACCOUNT_ID=
# Signs per-agent connect links (>= 32 random chars). Mint one: node src/connect-link.ts <agentId> <email>
BRIDGE_LINK_SECRET=

# Grip support scope (same values grip-sync uses). The bridge drops inbound messages from channels
# Grip lists as out_of_scope (paused/closed accounts, or not on the Customers page). Blank = disabled,
# everything is ingested. Fails open: if Grip is down the last good list is kept.
GRIP_BASE_URL=
GRIP_API_KEY=
SCOPE_REFRESH_SECONDS=300

# Team in every customer channel: after each scope refresh, add missing Kita team members to every
# in-scope Slack channel / Teams channel or chat (never removes anyone). off | dry-run | on.
# dry-run (default) only logs `teamsync_would_add`; switch to on after checking it.
TEAM_SYNC=dry-run
# Comma-separated emails. Blank = every active Chatwoot agent (needs CHATWOOT_API_ACCESS_TOKEN + CHATWOOT_ACCOUNT_ID).
TEAM_ROSTER=
# Never added (defaults to bridge@kita.ai).
TEAM_ROSTER_EXCLUDE=bridge@kita.ai

# Slack (api.slack.com/apps > your app)
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
# Kita's own workspace id (T...). Messages from Kita staff in shared channels are NOT
# ingested as customer messages. Comma-separate if several.
SLACK_INTERNAL_TEAM_IDS=
# Optional: only ingest from these channel ids (comma-separated). Blank = every channel the bot is in.
SLACK_ALLOWED_CHANNELS=
# Identity customers see on replies (needs chat:write.customize). Icon: public square PNG of the Kita mark.
SLACK_BOT_NAME=Kita
SLACK_BOT_ICON_URL=
# Per-agent Slack connect (Basic Information > App Credentials). Blank = everyone uses the bot fallback.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# Microsoft Teams, via Microsoft Graph as the licensed "Kita" user in Kita's own M365 tenant.
# No bot and no app install for customers. See README > Microsoft Teams.
TEAMS_TENANT_ID=
# Entra app registration (Application (client) ID + client secret value).
TEAMS_CLIENT_ID=
TEAMS_CLIENT_SECRET=
# The service account replies are posted as. The connect flow refuses any other account.
TEAMS_KITA_USER_UPN=kita@kita.ai
# Long random string (>= 16 chars). Required to start the one-time connect flow:
#   https://support.internal.kita.ai/bridges/teams/connect?key=<TEAMS_CONNECT_KEY>
TEAMS_CONNECT_KEY=
# Tenants whose non-guest members are Kita staff (their messages are never ingested). Defaults to TEAMS_TENANT_ID.
TEAMS_INTERNAL_TENANT_IDS=
# Optional: only watch these team ids (comma-separated). Blank = every Kita-hosted team the Kita user is in.
TEAMS_TEAM_IDS=
# Optional: extra "teamId/channelId" pairs to watch (e.g. a shared channel whose host team the Kita user isn't in).
TEAMS_EXTRA_CHANNELS=
# auto = plain HTML, Adaptive Card only if Teams rejects it in a channel; html = never cards; card = always cards in channels.
TEAMS_MESSAGE_FORMAT=auto

# WhatsApp Business app coexistence (Cloud API on the same numbers the team uses in the phone app).
# mirror (default): the desk shows WhatsApp conversations read-only; agents reply from the phone.
# send: replies typed in the desk go out through Cloud API (text within the 24h window).
WHATSAPP_MODE=mirror
# Meta app > App settings > Basic > App secret (verifies X-Hub-Signature-256).
WHATSAPP_APP_SECRET=
# Any random string; enter the same value as the "Verify token" in the Meta app's WhatsApp webhook config.
WHATSAPP_VERIFY_TOKEN=
# System-user (or business-integration) access token with whatsapp_business_messaging; used for media downloads.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PREFIX_AGENT_NAME=true
# One entry per teammate's number, as a JSON array. The Chatwoot webhook URL for each inbox is
#   https://support.internal.kita.ai/bridges/chatwoot/whatsapp/<phoneNumberId>
# agentAccessToken (optional) = that teammate's own Chatwoot access token, so phone replies show as them.
WHATSAPP_NUMBERS=[{"phoneNumberId":"","inboxIdentifier":"","webhookSecret":"","ownerName":"Carmel Limcaoco","agentAccessToken":""}]

# Encrypts stored OAuth tokens at rest (Kita Teams user + every agent's Slack/Teams token).
# >= 16 chars, e.g. `openssl rand -base64 32`. Changing it means everyone reconnects.
BRIDGE_ENCRYPTION_KEY=

# Viber (partners.viber.com bot)
VIBER_AUTH_TOKEN=
VIBER_BOT_NAME=Kita
# Viber is one business identity: prefix replies with the agent's first name ("Carmel: …").
VIBER_PREFIX_AGENT_NAME=true
VIBER_BOT_AVATAR=
