# kita-grip-sync configuration. Copy to kita-grip-sync/.env on the server. NEVER commit real values.
PORT=8080
GRIP_SYNC_DB_PATH=/data/grip-sync.sqlite
LOG_LEVEL=info

# Chatwoot account webhook secret (Settings > Integrations > Webhooks > the grip-sync webhook).
# Every delivery is verified: X-Chatwoot-Signature = sha256=HMAC(secret, "<timestamp>.<body>").
CHATWOOT_WEBHOOK_SECRET=
# Inside docker-compose the service reaches Rails directly.
CHATWOOT_BASE_URL=http://rails:3000
# Public desk URL, used for chatwoot_url links stored in Grip.
CHATWOOT_PUBLIC_URL=https://support.internal.kita.ai
# Access token of the "Kita Grip Sync" agent bot (or an administrator). Posts private notes and labels only.
CHATWOOT_API_TOKEN=
# Owner in the desk (Grip DRI -> conversation attributes + assignee). The bot token can set attributes and assign,
# but can't list agents or create attribute definitions: give an ADMINISTRATOR's access token here for those.
# Blank = attributes only, no assignment. OWNER_SYNC=false turns the feature off.
CHATWOOT_ADMIN_TOKEN=
OWNER_SYNC=true
AGENTS_REFRESH_SECONDS=600

# Grip support API.
GRIP_BASE_URL=https://internal.kita.ai
# grip_... service key (minted by SQL, see README). Without it nothing is synced.
GRIP_API_KEY=

# Claude classifier for automatic tickets.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
# Classify once per batch: wait this long after the last customer message...
CLASSIFY_DEBOUNCE_SECONDS=60
# ...but never longer than this after the first unclassified one.
CLASSIFY_MAX_WAIT_SECONDS=300
# Set to false to sync conversations only (no classification, tickets, notes or labels).
AUTO_TICKETS=true

# Either key enables automatic tickets; Anthropic wins if both are set.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
