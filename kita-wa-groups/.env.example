# kita-wa-groups: WhatsApp group chats -> the Kita desk via a DEDICATED linked-device number.
# Copy to kita-wa-groups/.env on the server. Never commit the real file.

# Same values as kita-bridges/.env (shared secret for server-to-server calls + signed pair links).
BRIDGE_LINK_SECRET=
# Encrypts the WhatsApp linked-device keys at rest on the wa_groups_data volume (>= 16 chars).
# Changing it makes the stored session unreadable: the service refuses to start until you re-pair.
BRIDGE_ENCRYPTION_KEY=

# Kita staff numbers: their messages show as Kita (not External). Optional "=email" matches the desk agent.
# The dedicated number itself is always Kita.
WA_GROUPS_KITA_NUMBERS=+639171234567=carmel@kita.ai,+14155550100=rhea@kita.ai

# Mirror-only by default. "on" lets desk replies post into the group as the Kita number
# (kita-bridges must also have WA_GROUPS_SEND=on). Keep it off.
WA_GROUPS_SEND=off

# Max group joins per hour (invite links). Joins are only ever done from the desk, never automatically.
WA_GROUPS_JOINS_PER_HOUR=5
# Import the history WhatsApp sends to the linked device at pairing (on|off).
WA_GROUPS_IMPORT_HISTORY=on
# Media larger than this is not copied (the message says so).
WA_GROUPS_MEDIA_MAX_MB=40

# Defaults suit docker-compose.kita.yaml:
# BRIDGES_INTERNAL_URL=http://bridges:8080
# WA_GROUPS_INTERNAL_URL=http://wa-groups:8090
# WA_GROUPS_DATA_DIR=/data
