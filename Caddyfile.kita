support.internal.kita.ai {
	# Channel bridges (Slack/Teams/Viber webhooks + Chatwoot API-channel webhooks); prefix is stripped.
	handle_path /bridges/* {
		reverse_proxy bridges:8080
	}
	# Chatwoot account webhook -> Grip sync (signed with the webhook secret); prefix is stripped.
	handle_path /grip-sync/* {
		reverse_proxy grip-sync:8080
	}
	# WhatsApp groups (pair page, health); prefix kept, the service accepts it. /internal/* is server-to-server only.
	handle /wa-groups/* {
		@waGroupsInternal path /wa-groups/internal/*
		respond @waGroupsInternal 404
		reverse_proxy wa-groups:8090
	}
	handle {
		reverse_proxy rails:3000
	}
}
